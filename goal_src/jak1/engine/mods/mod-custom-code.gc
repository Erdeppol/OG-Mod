;;-*-Lisp-*-
(in-package goal)

;; name: mod-custom-code.gc
;; name in dgo: mod-custom-code
;; dgos: TODO

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; What is this file for.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#|
 This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb
|#

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Begin function defintions.
;;;;;;;;;;;;;;;;;;;;;;;;;;

(define bh-power-cells 0)
(define bh-difficulty 0.0)
(define bh-difficulty-eff 0.0)
(define bh-difficulty-scale 1.0)
(define bh-difficulty-scale-higher 1.0)
(define bh-difficulty-scale-half 1.0)
(define bh-difficulty-scale-third 1.0)
(define bh-difficulty-scale-quartre 1.0)
(define bh-difficulty-scale-lesser 1.0)
(define bh-difficulty-start 0.0)
(define bh-difficulty-target 0.0)
(define bh-difficulty-time 0.0)
(define bh-difficulty-peak 85.0)
(define bh-difficulty-heal-start 0.15)
(define bh-difficulty-heal-stop 0.95)
(define bh-projectile-homing 0.0)
(define bh-projectile-homing-peak 45.0)
(define *bh-handle-idx* 0)
(define *bh-last-transition* #f)

(defun bh-on-zoomer? ()
  (and *target*
       (let ((s (-> *target* state name)))
         (or (= s 'target-racing)
             (= s 'target-racing-jump)
             (= s 'target-racing-falling)
             (= s 'target-racing-get-on)
             (= s 'target-racing-get-off)))))
(defun bh-zoomer-transition? ()
  (and *target*
       (let ((s (-> *target* state name)))
         (or (= s 'target-racing-get-on)
             (= s 'target-racing-get-off)))))

;; spawn one bullet that can hurt Jak
(defun bh-spawn-bullet ((pos vector) (dir vector) (lifetime float) (speed float) (options uint) (homing float) (bulletSize float) (lowSpeedNoKill int))
  (let ((vel (new 'stack-no-clear 'vector))
        (p (new 'stack-no-clear 'vector))
        (fwd (new 'stack-no-clear 'vector))
        (proc (get-process *default-dead-pool* projectile-yellow #x4000)))

    (vector-float*! vel dir speed)
    (set! (-> p quad) (-> pos quad))
    (when (bh-on-zoomer?)
      ;; Jak's horizontal movement direction, or his facing if he's stopped
      (set! (-> fwd quad) (-> *target* control transv quad))
      (set! (-> fwd y) 0.0)
      (set! bulletSize (* 0.33 bulletSize))
      (set! homing (* 0.33 homing))
      (if (< (vector-length fwd) (meters 0.5))
        (vector-z-quaternion! fwd (-> *target* control quat)))
      (vector-normalize! fwd 1.0)
      (vector+*! p p fwd (meters 45.0))

      (let ((away (new 'stack-no-clear 'vector)))
      (vector-! away p (-> *target* control trans))
      (set! (-> away y) 0.0)
      (vector-normalize! away 1.0)
      (vector+*! vel vel away (meters 12.0)))
    )

    (when (and *target* proc)
      ((method-of-type projectile-yellow activate)
       (the-as projectile-yellow proc) *target* 'projectile-yellow (the-as pointer #x70004000))
      ((the-as (function process function object object object object object object) run-function-in-process)
       proc projectile-init-by-other (the-as entity-actor #f) p vel (logior options (the-as uint 2560)) (the-as handle #f))

      (set! (-> (the-as projectile-yellow proc) timeout)
            (the-as time-frame (seconds lifetime)))
      
      (set!
        (-> (the-as sphere
              (-> (the-as projectile-yellow proc)
                  root root-prim local-sphere))
            r)
        (* (-> (the-as sphere
              (-> (the-as projectile-yellow proc)
                  root root-prim local-sphere))
            r)
          bulletSize))

      (set! (-> (the-as projectile-yellow proc) attack-mode) 'damage)
      (set! (-> (the-as projectile-yellow proc) bh-homing) homing)
      (set! (-> (the-as projectile-yellow proc) bh-nokill) lowSpeedNoKill)
      (set! (-> (the-as projectile-yellow proc) bh-grace) (the-as int (seconds 0.45)))
      (logior! (-> (the-as projectile-yellow proc) root root-prim collide-with) (collide-kind target))
      
      (set! (-> *bh-handles* *bh-handle-idx*) (the-as uint64 (process->handle proc)))
      (set! *bh-handle-idx* (logand (+ *bh-handle-idx* 1) 511))
    ))
  0)

(defun bh-ring ((center vector) (n int) (offset float) (radius float) (lifetime float) (speed float))
  (let* ((pos (new 'stack-no-clear 'vector))
         (dir (new 'stack-no-clear 'vector)))
    (dotimes (i n)
      (let* ((ang (+ offset
                     (* (/ 65536.0 (the float n))
                        (the float i)))))
        (set-vector!
          pos
          (+ (-> center x)
             (* (sin ang) radius))
          (+ (-> center y) (meters 2.3))
          (+ (-> center z)
             (* (cos ang) radius))
          1.0)
        (set-vector!
          dir
          (- (sin ang))
          0.0
          (- (cos ang))
          1.0)
        (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) bh-projectile-homing 0.25 1))))
  0)

(defun bh-ring-height ((center vector) (n int) (offset float) (radius float) (height float) (lifetime float) (speed float) (homing float))
  (let* ((pos (new 'stack-no-clear 'vector))
         (dir (new 'stack-no-clear 'vector)))
    (dotimes (i n)
      (let* ((ang (+ offset
                     (* (/ 65536.0 (the float n))
                        (the float i)))))
        (set-vector!
          pos
          (+ (-> center x)
             (* (sin ang) radius))
          (+ (-> center y) height)
          (+ (-> center z)
             (* (cos ang) radius))
          1.0)
        (set-vector!
          dir
          (- (sin ang))
          0.0
          (- (cos ang))
          1.0)
        (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) homing 0.25 1))))
  0)  

(define bh-next-heal-time 0)
(define bh-next-attack-time 0)
(define *bh-spin* 0.0)
(define *bh-center* (new 'global 'vector))
(defun bh-rain ((center vector) (gridSize int) (spacing float) (height float) (lifetime float) (speed float))
  (let* ((pos (new 'stack-no-clear 'vector))
         (dir (new 'stack-no-clear 'vector))
         (half (/ (- gridSize 1) 2)))
    (set-vector! dir 0.0 -1.0 0.0 1.0)

    (dotimes (x gridSize)
      (dotimes (z gridSize)
        (set-vector!
          pos
          (+ (-> center x)
             (* (the float (- x half)) spacing))
          (+ (-> center y) height)
          (+ (-> center z)
             (* (the float (- z half)) spacing))
          1.0)

        (bh-spawn-bullet pos dir lifetime speed (the-as uint 16) (* bh-projectile-homing 0.5) 0.23 0))))
  0)

(defun bh-sniper ((distance float) (height float) (lifetime float) (speed float) (homing float))
  (when *target*
    (let ((pos (new 'stack-no-clear 'vector))
          (fwd (new 'stack-no-clear 'vector))
          (dir (new 'stack-no-clear 'vector)))

      ;; Camera forward direction in world space
      (set! (-> fwd quad) (-> *math-camera* inv-camera-rot vector 2 quad))

      ;; Flatten to the ground plane so camera pitch doesn't matter
      (set! (-> fwd y) 0.0)
      (vector-normalize! fwd 1.0)

      ;; pos = Jak's position + camera forward * distance
      (vector+*! pos (-> *target* control trans) fwd distance)

      ;; Move upward in world space
      (+! (-> pos y) height)

      ;; Point toward Jak
      (vector-! dir (-> *target* control trans) pos)
      (vector-normalize! dir 1.0)

      (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) homing 0.25 0)))
  0)

  ;; radius = size of the ball, count = number of bullets in it
  ;; lead = how far ahead of Jak the bullets aim (0 = right at him)
  (defun bh-ball ((distance float) (height float) (radius float) (count int) (lead float) (lifetime float) (speed float) (homing float))
  (when *target*
    (let ((center (new 'stack-no-clear 'vector))
          (pos    (new 'stack-no-clear 'vector))
          (fwd    (new 'stack-no-clear 'vector))
          (dir    (new 'stack-no-clear 'vector))
          (move   (new 'stack-no-clear 'vector))
          (aim    (new 'stack-no-clear 'vector))
          (twist  (rand-vu-float-range 0.0 65536.0)))

      ;; Camera forward direction, flattened
      (set! (-> fwd quad) (-> *math-camera* inv-camera-rot vector 2 quad))
      (set! (-> fwd y) 0.0)
      (vector-normalize! fwd 1.0)

      ;; Ball center in front of the camera, above Jak
      (vector+*! center (-> *target* control trans) fwd distance)
      (+! (-> center y) height)

      ;; Jak's horizontal movement direction, or his facing if standing still
      (set! (-> move quad) (-> *target* control transv quad))
      (set! (-> move y) 0.0)
      (if (< (vector-length move) (meters 0.5))
        (vector-z-quaternion! move (-> *target* control quat)))
      (vector-normalize! move 1.0)

      ;; Aim point = Jak + movement direction * lead
      (vector+*! aim (-> *target* control trans) move lead)

      ;; One shared direction: toward the aim point
      (vector-! dir aim center)
      (vector-normalize! dir 1.0)

      ;; Fibonacci sphere: evenly spaced points on the surface
      (dotimes (i count)
        (let* ((sy (- 1.0 (* 2.0 (/ (+ (the float i) 0.5) (the float count)))))
               (sr (sqrtf (- 1.0 (* sy sy))))
               ;; 25032.74 = golden angle (137.5 degrees) in game rotation units
               (th (+ twist (* 25032.74 (the float i)))))
          (set-vector! pos
                       (+ (-> center x) (* radius sr (cos th)))
                       (+ (-> center y) (* radius sy))
                       (+ (-> center z) (* radius sr (sin th)))
                       1.0)
          (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) homing 0.25 0)))))
  0)

(defun bh-side-pair ((distance float) (height float) (sideDistance float) (lifetime float) (speed float) (homing float))
  (when *target*
    (let ((pos (new 'stack-no-clear 'vector))
            (fwd (new 'stack-no-clear 'vector))
            (right (new 'stack-no-clear 'vector))
            (dir (new 'stack-no-clear 'vector)))

      ;; Camera forward direction in world space.
      (set! (-> fwd quad) (-> *math-camera* inv-camera-rot vector 2 quad))

      ;; Flatten to the ground plane so camera pitch doesn't matter.
      (set! (-> fwd y) 0.0)
      (vector-normalize! fwd 1.0)

      ;; Camera right direction.
      (set-vector!
        right
        (-> fwd z)
        0.0
        (- (-> fwd x))
        0.0)

      (vector-normalize! right 1.0)

      ;; Center position = Jak + camera forward * distance.
      (vector+*! pos (-> *target* control trans) fwd distance)

      ;; Move upward in world space.
      (+! (-> pos y) height)

      ;; Right bullet.
      (vector+*! pos pos right sideDistance)

      ;; Point toward Jak.
      (vector-! dir (-> *target* control trans) pos)
      (vector-normalize! dir 1.0)

      (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) homing 0.25 0)

      ;; Recalculate center position.
      (vector+*! pos (-> *target* control trans) fwd distance)
      (+! (-> pos y) height)

      ;; Left bullet.
      (vector+*! pos pos right (- sideDistance))

      ;; Point toward Jak.
      (vector-! dir (-> *target* control trans) pos)
      (vector-normalize! dir 1.0)

      (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) homing 0.25 1)))
  0)

(defun bh-ground ((center vector) (gridSize int) (safeSpace float) (spacing float) (height float) (lifetime float) (speed float) (homing float))
  (when *target*
    (let* ((pos (new 'stack-no-clear 'vector))
          (dir (new 'stack-no-clear 'vector))
          (half (/ (- gridSize 1) 2)))

      (dotimes (x gridSize)
        (dotimes (z gridSize)

          (let* ((offsetX (* (the float (- x half)) spacing))
                (offsetZ (* (the float (- z half)) spacing)))

            (when (>= (+ (* offsetX offsetX)
                          (* offsetZ offsetZ))
                        (* safeSpace safeSpace))

              (set-vector!
                pos
                (+ (-> center x) offsetX)
                (+ (-> center y) height)
                (+ (-> center z) offsetZ)
                1.0)

              ;; Point from the bullet toward Jak.
              (vector-! dir (-> *target* control trans) pos)
              (vector-normalize! dir 1.0)

              (bh-spawn-bullet
                pos
                dir
                lifetime
                speed
                (the-as uint 16)
                homing
                0.35
                1))))))
    )
  0)

(defun bh-box ((center vector) (gridSize int) (distance float) (lifetime float) (speed float) (homing float))
  (let* ((pos (new 'stack-no-clear 'vector))
         (dir (new 'stack-no-clear 'vector))
         (last (- gridSize 1))
         (spacing (/ (* 2.0 distance) (the float (if (< last 1) 1 last)))))

    (dotimes (ix gridSize)
      (dotimes (iy gridSize)
        (dotimes (iz gridSize)

          ;; only the outer shell, skip the interior
          (when (or (= ix 0) (= ix last) (= iy 0) (= iy last) (= iz 0) (= iz last))
            (let* ((offsetX (- (* (the float ix) spacing) distance))
                   (offsetY (- (* (the float iy) spacing) distance))
                   (offsetZ (- (* (the float iz) spacing) distance)))

              (set-vector!
                pos
                (+ (-> center x) offsetX)
                (+ (-> center y) offsetY)
                (+ (-> center z) offsetZ)
                1.0)

              ;; Point toward from the center.
              (set-vector! dir (- offsetX) (- offsetY) (- offsetZ) 1.0)
              (vector-normalize! dir 1.0)

              (bh-spawn-bullet pos dir lifetime speed (the-as uint 16) homing 0.33 1)))))))
  0)

;; ---- trail pattern state ----
(define *bh-trail-active* #f)
(define *bh-trail-end* 0)
(define *bh-trail-next* 0)
(define *bh-trail-rate* 0)
(define *bh-trail-delay* 0)
(define *bh-trail-lifetime* 0.0)
(define *bh-trail-speed* 0.0)
(define *bh-trail-homing* 0.0)
(define *bh-trail-head* 0)
(define *bh-trail-count* 0)

;; queue of recorded spawns (max 32 pending), stored as separate floats
(define *bh-trail-px* (new 'global 'boxed-array float 32))
(define *bh-trail-py* (new 'global 'boxed-array float 32))
(define *bh-trail-pz* (new 'global 'boxed-array float 32))
(define *bh-trail-dx* (new 'global 'boxed-array float 32))
(define *bh-trail-dy* (new 'global 'boxed-array float 32))
(define *bh-trail-dz* (new 'global 'boxed-array float 32))
(define *bh-trail-due* (new 'global 'boxed-array int32 32))
(define *bh-trail-tmp-p* (new 'global 'vector))
(define *bh-trail-tmp-d* (new 'global 'vector))

(defun bh-trail-start ((duration float) (rate float) (delay float) (lifetime float) (speed float) (homing float))
  (set! *bh-trail-active* #t)
  (set! *bh-trail-next* (current-time))
  (set! *bh-trail-end* (the-as int (+ (current-time) (the int (fsec duration)))))
  (set! *bh-trail-rate* (the int (fsec rate)))
  (set! *bh-trail-delay* (the int (fsec delay)))
  (set! *bh-trail-lifetime* lifetime)
  (set! *bh-trail-speed* speed)
  (set! *bh-trail-homing* homing)
  (set! *bh-trail-head* 0)
  (set! *bh-trail-count* 0)
  0)

(defun bh-trail-update ()
  (when (and *target* *bh-trail-active*)
    ;; 1. spawn queued bullets whose delay has passed
    (while (and (> *bh-trail-count* 0)
                (>= (current-time) (-> *bh-trail-due* *bh-trail-head*)))
      (set-vector! *bh-trail-tmp-p*
                   (-> *bh-trail-px* *bh-trail-head*)
                   (-> *bh-trail-py* *bh-trail-head*)
                   (-> *bh-trail-pz* *bh-trail-head*)
                   1.0)
      (set-vector! *bh-trail-tmp-d*
                   (-> *bh-trail-dx* *bh-trail-head*)
                   (-> *bh-trail-dy* *bh-trail-head*)
                   (-> *bh-trail-dz* *bh-trail-head*)
                   1.0)
      (bh-spawn-bullet *bh-trail-tmp-p*
                       *bh-trail-tmp-d*
                       *bh-trail-lifetime*
                       *bh-trail-speed*
                       (the-as uint 16)
                       *bh-trail-homing*
                       0.5
                       1)
      (set! *bh-trail-head* (logand (+ *bh-trail-head* 1) 31))
      (+! *bh-trail-count* -1))

    ;; 2. record a new spawn on each tick while the duration lasts
    (when (and (< (current-time) *bh-trail-end*)
               (>= (current-time) *bh-trail-next*)
               (< *bh-trail-count* 32))
      (let ((idx (logand (+ *bh-trail-head* *bh-trail-count*) 31))
            (d (new 'stack-no-clear 'vector)))
        ;; position: Jak's chest right now
        (set! (-> *bh-trail-px* idx) (-> *target* control trans x))
        (set! (-> *bh-trail-py* idx) (+ (-> *target* control trans y) (meters 1.0)))
        (set! (-> *bh-trail-pz* idx) (-> *target* control trans z))
        ;; direction: Jak's horizontal movement, or facing if standing still
        (set! (-> d quad) (-> *target* control transv quad))
        (set! (-> d y) 0.0)
        (if (< (vector-length d) (meters 0.5))
          (vector-z-quaternion! d (-> *target* control quat)))
        (vector-normalize! d 1.0)
        (set! (-> *bh-trail-dx* idx) (-> d x))
        (set! (-> *bh-trail-dy* idx) 0.0)
        (set! (-> *bh-trail-dz* idx) (-> d z))
        (set! (-> *bh-trail-due* idx) (+ (current-time) *bh-trail-delay*))
        (+! *bh-trail-count* 1)
        (set! *bh-trail-next* (+ (current-time) *bh-trail-rate*))))

    ;; 3. finished once time is up and the queue is empty
    (when (and (>= (current-time) *bh-trail-end*) (zero? *bh-trail-count*))
      (set! *bh-trail-active* #f)))
  0)

(define *bh-circs-active* #f)
(define *bh-circs-index* 0)
(define *bh-circs-spin* 1.0)
(define *bh-circs-amount* 1)
(define *bh-circs-next* 0)
(define *bh-circs-delay* 0)
(define *bh-circs-radius* 0.0)
(define *bh-circs-height* 0.0)
(define *bh-circs-lifetime* 0.0)
(define *bh-circs-speed* 0.0)
(define *bh-circs-homing* 0.0)
;; horizontal direction of the first bullet, from Jak
(define *bh-circs-bx* 0.0)
(define *bh-circs-bz* 0.0)

;; side: 1.0 = start on camera right, -1.0 = start on camera left, 0.0 = random
(defun bh-circle-seq-start ((radius float) (height float) (amount int) (delay float) (side float) (lifetime float) (speed float) (homing float))
  (let ((fwd (new 'stack-no-clear 'vector))
        (s (if (= side 0.0)
             (if (rand-vu-percent? 0.5) 1.0 -1.0)
             side)))
    ;; camera forward, flattened, same as bh-side-pair
    (set! (-> fwd quad) (-> *math-camera* inv-camera-rot vector 2 quad))
    (set! (-> fwd y) 0.0)
    (vector-normalize! fwd 1.0)
    ;; first bullet sits on the camera's right (s = 1) or left (s = -1)
    (set! *bh-circs-bx* (* s (-> fwd z)))
    (set! *bh-circs-bz* (* s (- (-> fwd x))))
    ;; travel across the far side of Jak: right start goes left, left start goes right
    (set! *bh-circs-spin* (- s)))
  (set! *bh-circs-radius* radius)
  (set! *bh-circs-height* height)
  (set! *bh-circs-amount* amount)
  (set! *bh-circs-delay* (the int (fsec delay)))
  (set! *bh-circs-lifetime* lifetime)
  (set! *bh-circs-speed* speed)
  (set! *bh-circs-homing* homing)
  (set! *bh-circs-index* 0)
  (set! *bh-circs-next* (the-as int (current-time)))
  (set! *bh-circs-active* #t)
  0)

(defun bh-circle-seq-update ()
  (when (and *target* *bh-circs-active* (>= (current-time) *bh-circs-next*))
    (let* ((a (* (/ 65536.0 (the float *bh-circs-amount*)) (the float *bh-circs-index*)))
           (c (cos a))
           (s (sin a))
           (dx (+ (* *bh-circs-bx* c) (* *bh-circs-spin* *bh-circs-bz* s)))
           (dz (- (* *bh-circs-bz* c) (* *bh-circs-spin* *bh-circs-bx* s)))
           (pos (new 'stack-no-clear 'vector))
           (fwd (new 'stack-no-clear 'vector))
           (aim (new 'stack-no-clear 'vector))
           (dir (new 'stack-no-clear 'vector)))
      (set-vector! pos
                   (+ (-> *target* control trans x) (* dx *bh-circs-radius*))
                   (+ (-> *target* control trans y) *bh-circs-height*)
                   (+ (-> *target* control trans z) (* dz *bh-circs-radius*))
                   1.0)
      ;; aim point = Jak + his facing direction * lead
      (vector-z-quaternion! fwd (-> *target* control quat))
      (vector+*! aim (-> *target* control trans) fwd (meters 6.0))   ;; <- lead distance
      ;; horizontal direction from the bullet to the aim point
      (set-vector! dir
                   (- (-> aim x) (-> pos x))
                   0.0
                   (- (-> aim z) (-> pos z))
                   1.0)
      (vector-normalize! dir 1.0)
      (bh-spawn-bullet pos dir *bh-circs-lifetime* *bh-circs-speed* (the-as uint 0) *bh-circs-homing* 0.25 0)
      (+! *bh-circs-index* 1)
      (set! *bh-circs-next* (the-as int (+ (current-time) *bh-circs-delay*)))
      (if (>= *bh-circs-index* *bh-circs-amount*)
        (set! *bh-circs-active* #f))))
  0)

;; Four walls around the center, each moving along its own side (clockwise).
;; half-size = distance from center to each wall, count = bullets per wall,
;; inward = 0.0 pure train, >0 drifts toward the center so walls close in.
;; rows = number of rows per wall, row-gap = distance between rows
(defun bh-train ((count int) (spacing float) (rows int) (half-size float) (inward float) (lifetime float) (speed float) (speed-step float))
  (when *target*
    (let ((pos (new 'stack-no-clear 'vector))
          (dir (new 'stack-no-clear 'vector))
          (row-gap (meters 3.5))
          (backDistance (meters 5.0))
          (mid (/ (the float (- count 1)) 2.0))
          ;; Jak's facing angle, captured once when the pattern spawns
          (facing (if *target* (y-angle (-> *target* control)) 0.0)))
      (dotimes (side 4)
        (let* ((ang (+ facing 8192.0 (* 16384.0 (the float side))))
              (nx (sin ang))
              (nz (cos ang))
              (tx nz)
              (tz (- nx)))
          (dotimes (r rows)
            (let ((height (+ (meters 1.2) (* (the float r) row-gap))))
              (dotimes (i count)
                (let* ((along (* (- (the float i) mid) spacing))
                      (behind (the float (- (- count 1) i)))
                      (raw-speed (- speed (* behind speed-step)))
                      (b-speed (if (< raw-speed (meters 0.5)) (meters 0.5) raw-speed)))
                  (set-vector! pos
                    (+ (-> *bh-center* x)
                      (* nx (+ half-size backDistance))
                      (* tx along))
                    (+ (-> *bh-center* y) height)
                    (+ (-> *bh-center* z)
                      (* nz (+ half-size backDistance))
                      (* tz along))
                    1.0)
                  (set-vector! dir
                              (- tx (* nx inward))
                              0.0
                              (- tz (* nz inward))
                              1.0)
                  (vector-normalize! dir 1.0)
                  (bh-spawn-bullet pos dir lifetime b-speed (the-as uint 0) (* 0.5 bh-projectile-homing) 0.25 0))))))))
    )
  0)

(defun bh-cross ((distance float) (spacing float) (amount int) (base-speed float) (step-speed float) (lifetime float) (homing float))
  (when *target*
    (let* ((pos (new 'stack-no-clear 'vector))
           (dir (new 'stack-no-clear 'vector))
           (facing (y-angle (-> *target* control)))
           (place-ang (+ facing (rand-vu-float-range -20000.0 20000.0)))
           (place-elev (rand-vu-float-range -4000.0 12000.0))
           (flat (* (cos place-elev) distance))
           (cx (+ (-> *target* control trans x) (* (sin place-ang) flat)))
           (cy (+ (-> *target* control trans y) (meters 1.2) (* (sin place-elev) distance)))
           (cz (+ (-> *target* control trans z) (* (cos place-ang) flat)))
           ;; axis u
           (a1 (rand-vu-float-range 0.0 65536.0))
           (e1 (rand-vu-float-range -16384.0 16384.0))
           (ux (* (cos e1) (sin a1)))
           (uy (sin e1))
           (uz (* (cos e1) (cos a1)))
           ;; h, p, v 
           (hx (cos a1))
           (hz (- (sin a1)))
           (px (* uy hz))
           (py (- (* uz hx) (* ux hz)))
           (pz (- (* uy hx)))
           (t1 (rand-vu-float-range 0.0 65536.0))
           (vx (+ (* (cos t1) hx) (* (sin t1) px)))
           (vy (* (sin t1) py))
           (vz (+ (* (cos t1) hz) (* (sin t1) pz)))
           ;; third axis w = u x v
           (wx (- (* uy vz) (* uz vy)))
           (wy (- (* uz vx) (* ux vz)))
           (wz (- (* ux vy) (* uy vx))))
      (dotimes (arm 6)
        (let* ((axis (/ arm 2))
               (s (if (zero? (logand arm 1)) 1.0 -1.0))
               (dx (* s (cond ((= axis 0) ux) ((= axis 1) vx) (else wx))))
               (dy (* s (cond ((= axis 0) uy) ((= axis 1) vy) (else wy))))
               (dz (* s (cond ((= axis 0) uz) ((= axis 1) vz) (else wz)))))
          (dotimes (i amount)
            (let* ((dist (* (the float (+ i 1)) spacing))
                   (b-speed (+ base-speed (* (the float i) step-speed))))
              (set-vector! pos (+ cx (* dx dist)) (+ cy (* dy dist)) (+ cz (* dz dist)) 1.0)
              (set-vector! dir dx dy dz 1.0)
              (bh-spawn-bullet pos dir lifetime b-speed (the-as uint 0) homing 0.25 1)))))))
  0)

;; Ring of bullets at a random spot in front of Jak, randomly tilted.
;; distance = radius of the sphere around Jak where the center spawns
;; radius   = radius of the circle itself
;; speed    = outward speed of every bullet
;; Spiraling ring. Same placement as before.
;; swirl      = tangential velocity as a fraction of forward speed (0 = straight hoop, 1 = strong spin)
;; spread     = outward velocity as a fraction of forward speed (0 = ring keeps its size)
;; step-speed = extra speed per bullet index, which turns the ring into a spiral arm
(defun bh-circle ((amount int) (distance float) (radius float) (speed float) (swirl float) (spread float) (lifetime float) (homing float))
  (when *target*
    (let* (
           (pos (new 'stack-no-clear 'vector))
           (dir (new 'stack-no-clear 'vector))
           (n (new 'stack-no-clear 'vector))
           (h (new 'stack-no-clear 'vector))
           (facing (y-angle (-> *target* control)))
           (place-ang (+ facing (rand-vu-float-range -20000.0 20000.0)))
           (place-elev (rand-vu-float-range -4000.0 12000.0))
           (flat (* (cos place-elev) distance))
           (jx (-> *target* control trans x))
           (jy (+ (-> *target* control trans y) (meters 1.2)))
           (jz (-> *target* control trans z))
           (cx (+ jx (* (sin place-ang) flat)))
           (cy (+ jy (* (sin place-elev) distance)))
           (cz (+ jz (* (cos place-ang) flat))))
      (set-vector! n (- jx cx) (- jy cy) (- jz cz) 1.0)
      (vector-normalize! n 1.0)
      (set-vector! h (- (-> n z)) 0.0 (-> n x) 1.0)
      (vector-normalize! h 1.0)
      (let ((px (- (* (-> n y) (-> h z)) (* (-> n z) (-> h y))))
            (py (- (* (-> n z) (-> h x)) (* (-> n x) (-> h z))))
            (pz (- (* (-> n x) (-> h y)) (* (-> n y) (-> h x)))))
        (dotimes (i amount)
          (let* ((t1 (* 65536.0 (/ (the float i) (the float amount))))
                 (c (cos t1))
                 (s (sin t1))
                 ;; radial direction in the ring plane
                 (dx (+ (* c (-> h x)) (* s px)))
                 (dy (+ (* c (-> h y)) (* s py)))
                 (dz (+ (* c (-> h z)) (* s pz)))
                 ;; tangent = n x radial
                 (tx (- (* (-> n y) dz) (* (-> n z) dy)))
                 (ty (- (* (-> n z) dx) (* (-> n x) dz)))
                 (tz (- (* (-> n x) dy) (* (-> n y) dx)))
                 )
            (set-vector! pos
                         (+ cx (* dx radius))
                         (+ cy (* dy radius))
                         (+ cz (* dz radius))
                         1.0)
            ;; forward + outward + sideways
            (set-vector! dir
                         (+ (-> n x) (* dx spread) (* tx swirl))
                         (+ (-> n y) (* dy spread) (* ty swirl))
                         (+ (-> n z) (* dz spread) (* tz swirl))
                         1.0)
            (vector-normalize! dir 1.0)
            (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) homing 0.25 1))))))
  0)

;; Flat ring around Jak that slowly expands outward.
;; radius = starting distance of the ring from Jak
;; amount = number of bullets in the ring
;; speed  = outward speed of every bullet
;; gap = half-width of the empty zone in front of Jak (use (degrees 15.0) for +-15 degrees)
(defun bh-ring-out ((radius float) (amount int) (speed float) (gap float) (lifetime float) (homing float))
  (when *target*
    (let ((pos (new 'stack-no-clear 'vector))
          (dir (new 'stack-no-clear 'vector))
          (cx (-> *target* control trans x))
          (cy (+ (-> *target* control trans y) (meters 1.2)))
          (cz (-> *target* control trans z))
          (facing (y-angle (-> *target* control)))
          (offset (rand-vu-float-range 0.0 65536.0)))
      (dotimes (i amount)
        (let* ((ang (+ offset (* 65536.0 (/ (the float i) (the float amount)))))
               ;; angle relative to Jak's facing, wrapped to -32768..32767
               (rel (the float (sar (shl (the int (- ang facing)) 48) 48)))
               (dx (sin ang))
               (dz (cos ang)))
          (when (>= (fabs rel) gap)
            (set-vector! pos (+ cx (* dx radius)) cy (+ cz (* dz radius)) 1.0)
            (set-vector! dir dx 0.0 dz 1.0)
            (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) homing 0.5 1))))))
  0)

;; columns = total columns across the wall, spacing = gap between columns
;; rows / row-gap / height = vertical layout (height = lowest row above Jak's feet)
;; group = solid columns in a row, gap = empty columns between groups
(defun bh-wall ((columns int) (spacing float) (rows int) (row-gap float) (height float) (group int) (gap int) (speed float))
  (when *target*
    (let ((lifetime 3.0)
          (distance (meters 28.0))
          (fwd (new 'stack-no-clear 'vector))
          (pos (new 'stack-no-clear 'vector))
          (dir (new 'stack-no-clear 'vector)))
      ;; camera forward, flattened (same as bh-sniper)
      (set! (-> fwd quad) (-> *math-camera* inv-camera-rot vector 2 quad))
      (set! (-> fwd y) 0.0)
      (vector-normalize! fwd 1.0)
      (let* ((fx (-> fwd x))
             (fz (-> fwd z))
             ;; camera right
             (rx fz)
             (rz (- fx))
             (cx (+ (-> *target* control trans x) (* fx distance)))
             (cz (+ (-> *target* control trans z) (* fz distance)))
             (mid (/ (the float (- columns 1)) 2.0))
             (period (+ group gap))
             ;; random shift so the gaps land in a different place each time
             (phase (rand-vu-int-range 0 (- period 1))))
        ;; every bullet moves toward the camera
        (set-vector! dir (- fx) 0.0 (- fz) 1.0)
        (dotimes (c columns)
          (let ((k (+ c phase)))
            (when (< (- k (* (/ k period) period)) group)
              (let ((along (* (- (the float c) mid) spacing)))
                (dotimes (r rows)
                  (set-vector! pos
                               (+ cx (* rx along))
                               (+ (-> *target* control trans y) height (* (the float r) row-gap))
                               (+ cz (* rz along))
                               1.0)
                  (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) 0.01 0.4 0)))))))))
    0)

;; radius   = distance of the tornado wall from Jak
;; layers   = number of stacked rings, layer-gap = height between rings
;; amount   = bullets per ring
;; twist    = extra rotation per layer, e.g. (degrees 20.0), which gives the helix
;; inward   = 0 pure sideways, >0 drifts toward Jak
;; spin     = 1.0 or -1.0 for rotation direction (0.0 = random)
(defun bh-tornado ((radius float) (layers int) (amount int) (twist float) (inward float) (spin float) (speed float) (lifetime float))
  (when *target*
    (let ((layer-gap (meters 2.0))
          (pos (new 'stack-no-clear 'vector))
          (dir (new 'stack-no-clear 'vector))
          (cx (-> *target* control trans x))
          (cz (-> *target* control trans z))
          (offset (rand-vu-float-range 0.0 65536.0))
          (sp (if (= spin 0.0) (if (rand-vu-percent? 0.5) 1.0 -1.0) spin)))
      (dotimes (l layers)
        (dotimes (i amount)
          (let* ((a (+ offset (* twist (the float l)) (* 65536.0 (/ (the float i) (the float amount)))))
                 (dx (sin a))
                 (dz (cos a))
                 ;; sideways direction around Jak
                 (tx (* sp dz))
                 (tz (* sp (- dx))))
            (set-vector! pos
                         (+ cx (* dx radius))
                         (+ (-> *target* control trans y) (* (the float l) layer-gap) (meters -2.0))
                         (+ cz (* dz radius))
                         1.0)
            (set-vector! dir (- tx (* dx inward)) 0.0 (- tz (* dz inward)) 1.0)
            (vector-normalize! dir 1.0)
            (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) (* 0.25 bh-projectile-homing) 0.25 1))))))
  0)

(define bh-pattern-unlock-amount 3)
(defun bh-get-unlocked-patterns ()
  (+ 1
     (/ bh-power-cells bh-pattern-unlock-amount)))
(define bh-patterns-seen 0)
(define bh-implemented-patterns 26)
(defun bh-spawn-pattern ()
  (when *target*
    (vector-z-quaternion!
      *bh-center*
      (-> *target* control quat))
    (vector+!
      *bh-center*
      (-> *target* control trans)
      *bh-center*)

    ;; Effective difficulty is lower when on a bike and attack rate is also slower
    (set! bh-difficulty-eff bh-difficulty)
    (if (bh-on-zoomer?)
      (set! bh-difficulty-eff (* 0.6 bh-difficulty))
      (set! bh-next-attack-time (+ bh-next-attack-time (seconds 0.5)))
    )

    (set! bh-difficulty-scale (+ 1.0 bh-difficulty-eff))
    (set! bh-difficulty-scale-higher (+ 1.0 (* 1.25 bh-difficulty-eff)))
    (set! bh-difficulty-scale-half (+ 1.0 (* 0.5 bh-difficulty-eff)))
    (set! bh-difficulty-scale-third (+ 1.0 (* 0.33 bh-difficulty-eff)))
    (set! bh-difficulty-scale-quartre (+ 1.0 (* 0.25 bh-difficulty-eff)))
    (set! bh-difficulty-scale-lesser (+ 1.0 (* 0.75 bh-difficulty-eff)))
    (set! bh-projectile-homing (+ 0.01 (* bh-projectile-homing-peak bh-difficulty-eff)))

    (when (>= (-> *pc-settings* bh-mode) 2.0)
      (set! bh-difficulty 1.0)
    )
    ;; Choose between currently unlocked patterns.
    (let* (
      (patternCount (if (>= (-> *pc-settings* bh-mode) 1) 
          bh-implemented-patterns 
          (min (bh-get-unlocked-patterns) bh-implemented-patterns)
          ))
      (pattern (if (< bh-patterns-seen patternCount)
                  bh-patterns-seen
                  (rand-vu-int-count patternCount)
                )))
     ;;(set! pattern 16) ;; DEBUG
    (when (< bh-patterns-seen patternCount)
      (+! bh-patterns-seen 1))
      (case pattern
        ((8)
          ;; Ring
          (bh-ring
            *bh-center*
            (the int (* 3.0 bh-difficulty-scale))       ;; Amount
            *bh-spin*
            (/ (meters 26.0) bh-difficulty-scale-half)  ;; Distance
            (- 2.3 (* 0.65 bh-difficulty-eff))                 ;; Lifetime
            (* (meters 10.0) bh-difficulty-scale-half)       ;; Speed
          )
        )
        ((0)
          (bh-rain
            *bh-center*
            (the int (* 3.0 bh-difficulty-scale))       ;; Amount
            (/ (meters 20.0) bh-difficulty-scale-third)  ;; Distance Spacing
            (meters 16.0)                               ;; Height
            (- 2.7 (* 0.54 bh-difficulty-eff))              ;; Lifetime
            (* (meters 9.5) bh-difficulty-scale-quartre)       ;; Speed
            )
        )
        ((2)
          (bh-sniper
            (/ (meters 25.0) bh-difficulty-scale-quartre)     ;; Distance
            (/ (meters 12.0) bh-difficulty-scale-half)      ;; Height
            (- 2.6 (* 0.66 bh-difficulty-eff))                  ;; Lifetime
            (* (meters 16.0) bh-difficulty-scale-quartre)     ;; Speed
            (+ 60.0 bh-projectile-homing)                   ;; Homing
            )
          )
        ((17)
          (bh-side-pair
            (/ (meters 23.5) bh-difficulty-scale-third)     ;; Distance
            (/ (meters 8.5) bh-difficulty-scale-quartre)    ;; Height
            (/ (meters 20.5) bh-difficulty-scale-third)     ;; Side distance
            (- 2.7 (* 0.63 bh-difficulty-eff))                  ;; Lifetime
            (* (meters 12.0) bh-difficulty-scale-quartre)     ;; Speed
            (+ 35.0 bh-projectile-homing)                   ;; Homing
            )
          )
        ((4)
          (bh-ground
            *bh-center*
            (+ 5 (the int (* 3.0 bh-difficulty-scale-half)))  ;; Amount
            (/ (meters 8.0) bh-difficulty-scale-third)         ;; Safe space
            (/ (meters 13.0) bh-difficulty-scale-half)        ;; Distance Spacing
            (meters 2.0)                                      ;; Height
            (- 2.5 (* 0.5 bh-difficulty-eff))                 ;; Lifetime
            (* (meters 3.0) bh-difficulty-scale-half)         ;; Speed
            (+ 20.0 (* bh-projectile-homing 0.125))           ;; Homing
            )
        )
        ((5)
          (bh-box
            *bh-center*
            (the int (* 3.0 bh-difficulty-scale-third))      ;; Amount
            (/ (meters 13.0) bh-difficulty-scale-quartre)    ;; Distance
            (- 2.6 (* 0.5 bh-difficulty-eff))                    ;; Lifetime
            (* (meters 1.0) bh-difficulty-scale-half)        ;; Speed
            (+ 10.0 (* bh-projectile-homing 0.25))           ;; Homing
            )
          (set! bh-next-attack-time (+ bh-next-attack-time (seconds 0.75)))
        )
        ((6)
          (bh-trail-start
            (- 2.0 (* 0.25 bh-difficulty-eff))                    ;; Duration
            (/ 0.4 bh-difficulty-scale-half)                  ;; Rate
            (/ 0.8 bh-difficulty-scale-third)               ;; Delay
            (- 1.25 (* 0.25 bh-difficulty-eff))                   ;; Lifetime
            (* (meters 4.4) bh-difficulty-scale-lesser)              ;; Speed
            (+ 20.0 (* bh-projectile-homing))                 ;; Homing
            )
          (set! bh-next-attack-time (+ bh-next-attack-time (seconds 1.2)))
        )
        ((7)
          (bh-train
            (+ 2 (min 1 (the int (* 2.0 bh-difficulty-eff))))           ;; bullets per row
            (/ (meters 6.0) bh-difficulty-scale)         ;; Spacing in wall
            (+ 2 (min 1 (the int (* 2.0 bh-difficulty-eff))))         ;; rows per wall (2 to 3)
            (/ (meters 14.0) bh-difficulty-scale-half)       ;; distance of walls from Jak
            (+ 1.0 (* 0.25 bh-difficulty-eff))                 ;; inward drift
            (- 2.5 (* 0.6 bh-difficulty-eff))                  ;; lifetime
            (* (meters 10.0) bh-difficulty-scale-third)     ;; speed
            (* (meters 4.0) bh-difficulty-scale-third)     ;; speed Step subtracting
            )     
        )
        ((1)
          (bh-cross
            (/ (meters 19.0) bh-difficulty-scale-quartre)     ;; Distance
            (/ (meters 0.4) bh-difficulty-scale-third)        ;; Spacing
            (the int (+ 2 bh-difficulty-scale))       ;; Amount
            (* (meters 3.0) bh-difficulty-scale-half)        ;; Base Speed
            (* (meters 4.0) bh-difficulty-scale-half)         ;; Step Speed adding
            (- 4.0 (* 0.5 bh-difficulty-eff))                     ;; Lifetime
            (+ 10.0 (* bh-projectile-homing 0.33))            ;; Homing
            )
        )
        ((9)
          (bh-circle
            (the int (* 5.0 bh-difficulty-scale-half))     ;; Amount
            (/ (meters 20.0) bh-difficulty-scale-quartre)     ;; Distance
            (/ (meters 4.5) bh-difficulty-scale)        ;; Radius
            (* (meters 4.5) bh-difficulty-scale-lesser)         ;; Speed
            1.0         ;; Swirl 0 - 1
            (/ 1.0 bh-difficulty-scale)         ;; Spread 0 - 1
            (- 3.5 (* 0.5 bh-difficulty-eff))                     ;; Lifetime
            (+ 5.0 (* bh-projectile-homing 0.25))             ;; Homing
            )
        )
        ((10)
          (bh-ring-out
            (/ (meters 11.0) bh-difficulty-scale-half)     ;; Radius
            (the int (* 6.0 bh-difficulty-scale))      ;; Amount
            (/ (meters 12.0) bh-difficulty-scale-lesser)         ;; Speed
            (/ (degrees 25.0) bh-difficulty-scale-half)         ;; Gap
            (- 3.0 (* 0.5 bh-difficulty-eff))                     ;; Lifetime
            (+ 30.0 (* bh-projectile-homing 0.75))             ;; Homing
            )
        )
        ((11)
          (bh-side-pair
            (/ (meters 18.0) bh-difficulty-scale-third)     ;; Distance
            (/ (meters 6.0) bh-difficulty-scale-quartre)    ;; Height
            (/ (meters 22.0) bh-difficulty-scale-third)     ;; Side distance
            (- 4.2 (* 0.7 bh-difficulty-eff))                  ;; Lifetime
            (* (meters 7.0) bh-difficulty-scale-quartre)     ;; Speed
            (+ 100.0 bh-projectile-homing)                   ;; Homing
            )
          )
        ((12)
          (bh-circle-seq-start
            (/ (meters 20.0) bh-difficulty-scale-quartre)     ;; Radius
            (/ (meters 9.0) bh-difficulty-scale-quartre)    ;; Height
            (the int (* 6.0 bh-difficulty-scale))             ;; Amount
            (/ 0.45 bh-difficulty-scale)                       ;; Delay
            0.0     ;; Side
            (- 3.1 (* 0.47 bh-difficulty-eff))                     ;; Lifetime
            (* (meters 8.75) bh-difficulty-scale-quartre)     ;; Speed
            (+ 40.0 (* 0.4 bh-projectile-homing))                    ;; Homing
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 2.0)))
          )
        ((13)
          (bh-ball
            (/ (meters 35.0) bh-difficulty-scale-quartre)     ;; Distance
            (/ (meters 16.0) bh-difficulty-scale-half)      ;; Height
            (* (meters 1.0) bh-difficulty-scale-half)           ;; Radius
            (the int (* 8.0 bh-difficulty-scale))            ;; Amount
            (meters 10.0)                                   ;; Lead
            (- 2.7 (* 0.6 bh-difficulty-eff))                  ;; Lifetime
            (* (meters 13.0) bh-difficulty-scale-quartre)     ;; Speed
            (* 0.54 bh-projectile-homing)                   ;; Homing
            )
          )
        ((14)
          (bh-wall
            (the int (* 8.0 bh-difficulty-scale-half))       ;; Columns
            (/ (meters 3.1) bh-difficulty-scale-third)        ;; Spacing
            (the int (* 5.0 bh-difficulty-scale-quartre))     ;; Rows
            (/ (meters 2.0) bh-difficulty-scale-third)        ;; Row gap
            (- (meters 1.0) bh-difficulty)                    ;; height
            2                                                 ;; group >= 1 gap decider
            1                                                 ;; Gap
            (* (meters 11.0) bh-difficulty-scale-third)     ;; Speed
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 1.0)))
        )
        ((15)
          (bh-wall
            (the int (* 9.0 bh-difficulty-scale-half))        ;; Columns
            (/ (meters 2.8) bh-difficulty-scale-quartre)      ;; Spacing
            (the int (* 1.0 bh-difficulty-scale))             ;; Rows
            (meters 1.25)                                      ;; Row gap
            (- (meters 0.1) bh-difficulty)                    ;; height
            1                                                 ;; group >= 1 gap decider
            0                                                 ;; Gap
            (* (meters 13.0) bh-difficulty-scale-third)     ;; Speed
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 1.0)))
        )
        ((16)
          (bh-tornado
            (meters 27.5)        ;; Radius
            (the int (* 5.0 bh-difficulty-scale))             ;; Layers
            (the int (/ 12.0 bh-difficulty-scale))            ;; Bullet per ring
            (* (degrees 30.0) bh-difficulty-scale-third)       ;; Twist
            (* 0.75 bh-difficulty-scale)                         ;; Inwards
            0.0                                                 ;; Spin Rotation direction 0 is random
            (* (meters 12.0) bh-difficulty-scale-quartre)     ;; Speed
            (- 2.75 (* 0.6 bh-difficulty-eff))                     ;; Lifetime
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 1.0)))
        )
        ((3)
          (bh-ring-out
            (/ (meters 11.0) bh-difficulty-scale-third)     ;; Radius
            (the int (* 3.0 bh-difficulty-scale-lesser))      ;; Amount
            (* (meters 7.5) bh-difficulty-scale-quartre)         ;; Speed
            (/ (degrees 25.0) bh-difficulty-scale-half)         ;; Gap
            (- 5.5 (* 0.5 bh-difficulty-eff))                     ;; Lifetime
            (+ 100.0 (* bh-projectile-homing 0.5))             ;; Homing
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 2.0)))
        )
        ((18)
          ;; Ring
          (bh-ring-height
            *bh-center*
            (the int (* 5.0 bh-difficulty-scale-third))       ;; Amount
            *bh-spin*
            (/ (meters 20.0) bh-difficulty-scale-quartre)  ;; Distance
            (meters 0.5)      ;; Height
            (- 3.5 (* 0.5 bh-difficulty-eff))                 ;; Lifetime
            (* (meters 9.0) bh-difficulty-scale-third)       ;; Speed
            (* 0.1 bh-projectile-homing)                   ;; Homing
          )
          (bh-ring-height
            *bh-center*
            (the int (* 5.0 bh-difficulty-scale-third))       ;; Amount
            *bh-spin*
            (/ (meters 30.0) bh-difficulty-scale-quartre)  ;; Distance
            (meters 7.0)      ;; Height
            (- 3.5 (* 0.5 bh-difficulty))                 ;; Lifetime
            (* (meters 8.0) bh-difficulty-scale-third)       ;; Speed
            (* 0.1 bh-projectile-homing)                   ;; Homing
          )
          (set! bh-next-attack-time (+ bh-next-attack-time (seconds (* 1.0 bh-difficulty-eff))))
          (set! bh-next-attack-time (+ bh-next-attack-time (seconds 1.0)))

        )
        ((19)
          (bh-ring
            *bh-center*
            (the int (* 7.0 bh-difficulty-scale-half))       ;; Amount
            *bh-spin*
            (/ (meters 17.0) bh-difficulty-scale-third)  ;; Distance
            (- 2.9 (* 0.64 bh-difficulty-eff))                 ;; Lifetime
            (meters (* 1.0 bh-difficulty-scale-lesser))       ;; Speed
          )
          (set! bh-next-attack-time (+ bh-next-attack-time (seconds 1.0)))
        )
        ((21)
          (bh-tornado
            (/ (meters 20.0) bh-difficulty-scale-quartre)        ;; Radius
            (the int (* 5.0 bh-difficulty-scale))             ;; Layers
            (the int (/ 8.0 bh-difficulty-scale))            ;; Bullet per ring
            (* (degrees 30.0) bh-difficulty-scale-third)       ;; Twist
            (* 0.5 bh-difficulty-scale)                         ;; Inwards
            0.0                                                 ;; Spin Rotation direction 0 is random
            (* (meters 6.0) bh-difficulty-scale-third)     ;; Speed
            (- 4.0 (* 0.7 bh-difficulty-eff))                     ;; Lifetime
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 3.0)))
        )
        ((20)
          (bh-ball
            (/ (meters 37.0) bh-difficulty-scale-quartre)     ;; Distance
            (/ (meters 16.0) bh-difficulty-scale-half)      ;; Height
            (* (meters 2.0) bh-difficulty-scale-half)           ;; Radius
            (the int (* 12.0 bh-difficulty-scale))            ;; Amount
            (meters 18.0)                                   ;; Lead
            (- 3.0 (* 0.63 bh-difficulty-eff))                  ;; Lifetime
            (* (meters 14.0) bh-difficulty-scale-quartre)     ;; Speed
            (* 0.4 bh-projectile-homing)                   ;; Homing
            )
          (bh-ball
            (/ (meters 37.0) bh-difficulty-scale-quartre)     ;; Distance
            (/ (meters 16.0) bh-difficulty-scale-half)      ;; Height
            (* (meters 2.0) bh-difficulty-scale-half)           ;; Radius
            (the int (* 12.0 bh-difficulty-scale))            ;; Amount
            (meters -18.0)                                   ;; Lead
            (- 3.0 (* 0.63 bh-difficulty-eff))                  ;; Lifetime
            (* (meters 14.0) bh-difficulty-scale-quartre)     ;; Speed
            (* 0.4 bh-projectile-homing)                   ;; Homing
            )
          )
        ((22)
          (bh-wall
            (the int (* 8.0 bh-difficulty-scale-half))        ;; Columns
            (/ (meters 2.5) bh-difficulty-scale-quartre)      ;; Spacing
            (the int (* 5.0 bh-difficulty-scale-quartre))     ;; Rows
            (meters 2.0)                                      ;; Row gap
            (- (meters 1.0) bh-difficulty)                    ;; height
            1                                                 ;; group >= 1 gap decider
            1                                                 ;; Gap
            (* (meters 13.0) bh-difficulty-scale-third)     ;; Speed
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 1.5)))
        )
        ((23)
          (bh-box
            *bh-center*
            (the int (* 3.0 bh-difficulty-scale-third))      ;; Amount
            (/ (meters 16.5) bh-difficulty-scale-quartre)    ;; Distance
            (- 5.0 (* 0.5 bh-difficulty-eff))                    ;; Lifetime
            (* (meters 2.0) bh-difficulty-scale-lesser)        ;; Speed
            (+ 20.0 (* bh-projectile-homing 0.3))           ;; Homing
            )
          (set! bh-next-attack-time (+ bh-next-attack-time (seconds 5.25)))
        )
        ((24)
          (bh-wall
            (the int (* 9.0 bh-difficulty-scale-half))        ;; Columns
            (/ (meters 2.8) bh-difficulty-scale-quartre)      ;; Spacing
            1                                                 ;; Rows
            (meters 2.0)                                      ;; Row gap
            (meters 6.0)                                      ;; height
            1                                                 ;; group >= 1 gap decider
            0                                                 ;; Gap
            (* (meters 14.0) bh-difficulty-scale-third)     ;; Speed
            )
          (bh-wall
            (the int (* 7.0 bh-difficulty-scale-half))        ;; Columns
            (/ (meters 2.8) bh-difficulty-scale-quartre)      ;; Spacing
            1                                                 ;; Rows
            (meters 2.0)                                      ;; Row gap
            (meters 6.5)                                      ;; height
            1                                                 ;; group >= 1 gap decider
            0                                                 ;; Gap
            (* (meters 12.0) bh-difficulty-scale-third)     ;; Speed
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 1.5)))
        )
        ((25)
          (bh-ball
            (meters 35.0)     ;; Distance
            (/ (meters 19.0) bh-difficulty-scale-half)      ;; Height
            (* (meters 4.0) bh-difficulty-scale-half)           ;; Radius
            (the int (* 12.0 bh-difficulty-scale))            ;; Amount
            (meters 20.0)                                   ;; Lead
            (- 3.5 (* 0.6 bh-difficulty-eff))                  ;; Lifetime
            (* (meters 15.0) bh-difficulty-scale-quartre)     ;; Speed
            (+ 40.0 (* bh-projectile-homing 0.25))                   ;; Homing
            )
            (set! bh-next-attack-time (+ bh-next-attack-time (seconds 2.5)))
          )
        )))
  0)

(defun bh-debug-difficulty ()
  (format #t "BH Power Cells: ~d  Difficulty: ~f" bh-power-cells bh-difficulty)
  0)

(define bh-difficulty-reset-duration 10.0)
(defun bh-update-difficulty ()

  (set! bh-power-cells (the int (-> *game-info* fuel)))

  (set! bh-difficulty-target
      (if (>= bh-power-cells 100)
        0.0
        (fmax 0.0
          (fmin 1.0
            (/ (the float bh-power-cells)
               bh-difficulty-peak))))
      )

  (when (< (current-time) bh-difficulty-time)

    (let ((t
             (- 1.0
                (/ (the float (- bh-difficulty-time (current-time)))
                   (the float (seconds bh-difficulty-reset-duration))))))

      (set! bh-difficulty
            (+ bh-difficulty-start
               (* (- bh-difficulty-target bh-difficulty-start) t)))

      ;;(bh-debug-difficulty)
      ))

  (when (>= (current-time) bh-difficulty-time)
    (set! bh-difficulty bh-difficulty-target))
  0)

(defun bh-clear-bullets ()
  (dotimes (i 512)
    (when (nonzero? (-> *bh-handles* i))
      (let ((p (handle->process (the-as handle (-> *bh-handles* i)))))
        (when p (deactivate p)))))
  (set! *bh-trail-active* #f)
  (set! *bh-trail-count* 0)
  0)

(define *bh-resume-time* 0)
(define bh-want-to-clear 0)
(defun bh-jak-took-damage ()
  (set! bh-want-to-clear 2)
  (set! *bh-resume-time* (the-as int (max (+ (current-time) (seconds 0.5)) (+ *bh-resume-time* (seconds 0.5)))))
0)

(define bh-base-heal-rate 13.0)
(define bh-base-heal-low-health-multiply 0.66)
(define bh-heal-rate bh-base-heal-rate)
(defun bh-spawn-heal ()
  (set! bh-heal-rate bh-base-heal-rate)
  (when (and *target* (not (bh-on-zoomer?)) (> bh-difficulty bh-difficulty-heal-start) (< bh-difficulty bh-difficulty-heal-stop))
    (let (
      (health (-> *target* fact health))
      (max-health (-> *target* fact health-max))
      )
      (when (< health max-health)
        (let ((missing-health (- max-health health)))
          (set! bh-heal-rate (/ bh-base-heal-rate (+ 1.0 (* 0.5 bh-difficulty))))
          (when (>= missing-health 2)
            (set! bh-heal-rate (* bh-base-heal-low-health-multiply (/ bh-base-heal-rate (+ 1.0 (* 0.5 bh-difficulty)))))
            )
          (let (;;(basePos (new 'stack-no-clear 'vector))
                (pos (new 'stack-no-clear 'vector))
                (fwd (new 'stack-no-clear 'vector))
                (right (new 'stack-no-clear 'vector))
          )
          ;;(set! (-> basePos quad) (-> *target* control trans quad))
          ;;(set! (-> pos quad) (-> basePos quad))
          ;; Camera forward direction in world space.
          (set! (-> fwd quad) (-> *math-camera* inv-camera-rot vector 2 quad))
          ; Flatten to the ground plane.
          (set! (-> fwd y) 0.0)
          (vector-normalize! fwd 1.0)
          ;; Camera right direction.
          (set-vector!
            right
            (-> fwd z)
            0.0
            (- (-> fwd x))
            0.0)
          (vector-normalize! right 1.0)

            ;; (let ((angle (rand-vu-float-range 0.0 65536.0))
            ;;        (distance (rand-vu-float-range 3.0 12.0)))


          ;; Start in front of Jak.
          (vector+*! pos
            (-> *target* control trans)
            fwd
            (meters (rand-vu-float-range 6.0 16.0)))

          ;; Random horizontal position within the visible area.
          (vector+*! pos
            pos
            right
            (meters (rand-vu-float-range -16.0 16.0)))

          ;; Small random variation forward/backward.
          (vector+*! pos pos fwd (meters (rand-vu-float-range -2.0 2.0)))

            ;; (+! (-> pos x) (* (meters distance) (cos angle)))
            ;; (+! (-> pos z) (* (meters distance) (sin angle)))
            (+! (-> pos y) (meters 2.0))
            (birth-pickup-at-point
              pos
              (pickup-type eco-pill)
              10.0
              #t
              *entity-pool*
              (the-as fact-info #f)))
          )
        )
      )
    )
  0)
(define *bh-launched* #f)
(defun bh-update-launch ()
  (let ((name (if (and *target* (-> *target* next-state))
                (-> *target* next-state name)
                #f)))
    (cond
      ((= name 'target-launch) (set! *bh-launched* #t))
      ((= name 'target-duck-high-jump-jump) #f)   ; keep the flag as it is
      (else (set! *bh-launched* #f))))
  0)
(defun bh-clear-above-jak ((radius float) (min-above float))
  (when *target*
    (let ((jpos (-> *target* control trans)))
      (dotimes (i 512)
        (when (nonzero? (-> *bh-handles* i))
          (let ((proc (handle->process (the-as handle (-> *bh-handles* i)))))
            (when proc
              (let ((bpos (-> (the-as projectile proc) root trans)))
                (when (and (> (- (-> bpos y) (-> jpos y)) min-above)
                           (< (vector-vector-xz-distance bpos jpos) radius))
                  (deactivate proc)
                  ;; zero the slot the same way bh-clear-bullets does
                  (set! (-> *bh-handles* i) (the-as uint 0))))))))))
  0)

(define *bh-in-cannon* #f)
(defun bh-update-cannon ()
  (let* ((st (if *target* (-> *target* next-state) #f))
         (now (and st (eq? st target-periscope))))
    (when (not (eq? now *bh-in-cannon*))
      (set! *bh-in-cannon* (if now #t #f))
      (bh-clear-bullets)))
  0)
  
(define *bh-last-movie* #t)
(defun bullet-hell-update ()
  (bh-update-cannon)
  (bh-update-launch)
  (when (> bh-want-to-clear 0)
    (set! bh-want-to-clear (- bh-want-to-clear 1))
    (when (= 0 bh-want-to-clear)
      (bh-clear-bullets)
    )
  )
  (when *bh-launched*
  (
    bh-clear-above-jak (meters 70) (meters 3))
    (set! *bh-resume-time* (the-as int (max (+ (current-time) (seconds 0.85)) *bh-resume-time*)))
  )

  ;; Movie no spam
  (let ((m (if (-> *setting-control* current movie) #t #f)))
  (if (and m (not *bh-last-movie*))
    (bh-clear-bullets))
  (if (and (not m) *bh-last-movie*)
    (set! *bh-resume-time* (+ (current-time) (seconds 2.0))))
  (set! *bh-last-movie* m))

  ;;Getting on/off bike no spam
  (let ((tr (if (bh-zoomer-transition?) #t #f)))
  (when tr
    (if (not *bh-last-transition*)
      (bh-clear-bullets))
    (set! *bh-resume-time* (the-as int (+ (current-time) (seconds 1.0)))))
  (set! *bh-last-transition* tr))

  (when (and *target*
             (not *bh-last-movie*)
             (>= (current-time) *bh-resume-time*))
    (bh-update-difficulty)
    (bh-trail-update)
    (bh-circle-seq-update)
    (when (= (-> *pc-settings* bh-mode) 2.0)
      (set! bh-difficulty 1.0)
    )
    (when (> bh-difficulty 0.0)
      (when (>= (current-time) bh-next-attack-time)
        
        (bh-spawn-pattern)
        ;; (when (>= (current-time) bh-next-heal-time)
          ;; (bh-spawn-heal)
          ;; (set! bh-next-heal-time
            ;; (+ (current-time) (seconds bh-heal-rate)))
          ;; )
        
        (+! *bh-spin* 2000.0)

        (set! bh-next-attack-time
          (+ (current-time)
            (seconds
              (fmax 2.1
                (/ 3.6 bh-difficulty-scale)
                )
              )
            )
          )
        )
      )
    )
  0)

;; set one init-spec's value (and clear its random range)
(defun bh-set-spec ((part-id int) (idx int) (val float))
  (set! (-> *part-id-table* part-id init-specs idx initial-valuef) val)
  (set! (-> *part-id-table* part-id init-specs idx random-rangef) 0.0)
  0)

(defun bh-tint-particles ()
  ;; ---- flight trail: red, more opaque ----
  (bh-set-spec 350 8 128.0) (bh-set-spec 350 9 0.0) (bh-set-spec 350 10 96.0)   ;; glow: r, g, alpha
  (bh-set-spec 351 7 128.0) (bh-set-spec 351 8 0.0) (bh-set-spec 351 9 128.0)   ;; puff
  (bh-set-spec 352 2 (meters 1.0))                                              ;; Smoke trail (core)
  (bh-set-spec 353 5 140.0) (bh-set-spec 353 6 0.0) (bh-set-spec 353 8 128.0)   ;; sparks
  (bh-set-spec 353 1 0.1)

  ;; ---- spawn flash (group 103): remove green/blue ----
  (bh-set-spec 355 5 255.0) (bh-set-spec 355 6 0.0)                              ;; starflash
  (bh-set-spec 356 4 200.0) (bh-set-spec 356 5 0.0)                              ;; sparks
  (bh-set-spec 357 8 160.0) (bh-set-spec 357 9 0.0) (bh-set-spec 357 10 0.0)    ;; puffs
  (bh-set-spec 359 7 200.0) (bh-set-spec 359 8 0.0)                              ;; embers

  ;; ---- explosion (group 104) ----
  (bh-set-spec 2059 4 255.0) (bh-set-spec 2059 5 255.0) (bh-set-spec 2059 6 255.0) (bh-set-spec 2059 7 200.0) ;; big flash
  (bh-set-spec 2060 4 255.0) (bh-set-spec 2060 5 225.0) (bh-set-spec 2060 6 200.0) (bh-set-spec 2060 7 70.0)  ;; sparks
  (bh-set-spec 2061 5 255.0) (bh-set-spec 2061 6 0.0) (bh-set-spec 2061 7 0.0) (bh-set-spec 2061 8 50.0)       ;; smoke puffs
  (bh-set-spec 2062 5 255.0) (bh-set-spec 2062 6 0.0) (bh-set-spec 2062 7 0.0) (bh-set-spec 2062 8 55.0)      ;; streaks
  ;; sizes
  (bh-set-spec 2059 2 (meters 0.75))
  (bh-set-spec 2060 2 (meters 0.15))
  (bh-set-spec 2061 2 (meters 0.25))
  (bh-set-spec 2062 2 (meters 0.1))
  (bh-set-spec 2062 4 (meters 0.05))
  (bh-set-spec 2059 8 -8.0) ;; Flash fade
  0)

(defun debugcheator ()
  (when *debug-segment*
    (when (cpad-pressed? 0 l3)
      (set! (-> *game-info* fuel) (fmax 0.0 (- (-> *game-info* fuel) 1.0)))
      (set! bh-difficulty
            (fmax 0.0 (- bh-difficulty (/ 10.0 bh-difficulty-peak))))
      (bh-debug-difficulty)
      (bh-clear-bullets))

    (when (cpad-pressed? 0 r3)
      (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1.0))
      (set! bh-difficulty
            (fmin 1.0 (+ bh-difficulty (/ 10.0 bh-difficulty-peak))))
      (bh-debug-difficulty)
      (bh-clear-bullets))
  )
)

(defun runs-every-frame ()
  (if *show-input-display* (input-display-on) (input-display-off))
  
  (when *debug-segment*
    (orb-placer-maintenance))

  (debugcheator)
  (bullet-hell-update)
  (bh-tint-particles)
  
  (none))

(defun bh-orb-bullet-above ((center vector) (height float) (lifetime float) (speed float))
  (let* ((pos (new 'stack-no-clear 'vector))
         (dir (new 'stack-no-clear 'vector)))
    (set-vector! dir 0.0 -1.0 0.0 1.0)
    (set-vector! pos (-> center x) (+ (-> center y) height) (-> center z) 1.0)
    (bh-spawn-bullet pos dir lifetime speed (the-as uint 16) bh-projectile-homing 0.33 0))
  0)

(define *bh-orb-ring-index* 0)
(define *bh-orb-ring-last* 0)
;; one bullet on a circle around Jak, flying toward him
(defun bh-orb-bullet-ring ((radius float) (step float) (lifetime float) (speed float))
  (when *target*
    ;; restart the circle if no orb was picked up for 2 seconds
    (when (>= (current-time) (+ *bh-orb-ring-last* (seconds 2.0)))
      (set! *bh-orb-ring-index* 0))
    (set! *bh-orb-ring-last* (current-time))
    (let* ((ang (* step (the float *bh-orb-ring-index*)))
           (pos (new 'stack-no-clear 'vector))
           (dir (new 'stack-no-clear 'vector)))
      (set-vector! pos
                   (+ (-> *target* control trans x) (* (sin ang) radius))
                   (+ (-> *target* control trans y) (meters 0.5))   ;; low, near feet/waist
                   (+ (-> *target* control trans z) (* (cos ang) radius))
                   1.0)
      ;; fly toward Jak, horizontally
      (set-vector! dir (- (sin ang)) 0.0 (- (cos ang)) 1.0)
      (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) bh-projectile-homing 0.33 1)
      (+! *bh-orb-ring-index* 1)))
  0)

;; Spawn a dense circle of bullets around Jak that all drift upward.
(defun bh-fly-bullet-ring ((radius float) (amount int) (height float) (lifetime float) (speed float))
  (when *target*
    (let* ((pos (new 'stack-no-clear 'vector))
            (dir (new 'stack-no-clear 'vector))
            (step (/ 65536.0 (the float amount)))
            (verticalSpeed (meters 2.5))
            (cx (-> *target* control trans x))
            (cz (-> *target* control trans z)))

      (dotimes (i amount)
        (let* ((ang (* step (the float i)))
                (dx (sin ang))
                (dz (cos ang))
                ;; Tangential direction around Jak.
                (tx dz)
                (tz (- dx))
                ;; Convert desired vertical speed into a direction component.
                (verticalRatio (/ verticalSpeed speed)))

          (set-vector! pos (+ cx (* dx radius)) (+ (-> *target* control trans y) height) (+ cz (* dz radius)) 1.0)
          (set-vector! dir tx verticalRatio tz 1.0)
          (vector-normalize! dir 1.0)
          (bh-spawn-bullet pos dir lifetime speed (the-as uint 0) bh-projectile-homing 0.33 1)))))
  0)

(defun bh-jak-launching? ()
  (and *target*
       (let ((st (-> *target* next-state)))
         (and st (= (-> st name) 'target-launch)))))


(defun runs-on-orb-pickup ((parent process-tree))
  (when *target*
    (let* ((from-cache? (and parent (type-type? (-> parent type) orb-cache-top))))
    ;; Code here runs on ANY orb pickup
    
      (when from-cache?
        (bh-orb-bullet-ring
          (meters 20.0)                              ;; radius
          10922.0                                     ;; step: 65536/6, 6 bullets per full circle
          (- 2.6 (* 0.65 bh-difficulty-eff))         ;; lifetime
          (* (meters 6.0) bh-difficulty-scale-third))     ;; speed
      )
      (when (and (not (bh-jak-launching?)) (not from-cache?))
        (pickup-collectable! (-> *target* fact) (pickup-type eco-pill) 1.0 (the-as handle #f))
        (bh-orb-bullet-above
                (-> *target* control trans)
                (meters 19.0)                             ;; Height
                (- 2.4 (* 0.67 bh-difficulty-eff))          ;; Lifetime
                (* (meters 9.0) bh-difficulty-scale)       ;; Speed
              )
      ))
    )
  (none))

(defun runs-on-fly-pickup ()
  ;; Code here runs on any scout fly pickup
  (when *target*
    (bh-fly-bullet-ring
      (/ (meters 10.0) bh-difficulty-scale-lesser)         ;; Radius
      (+ 8 (the int (* 3.0 bh-difficulty-scale)))         ;; Amount
      (meters -2.0)                                 ;; Height
      (- 2.25 (* 0.5 bh-difficulty-eff))            ;; Lifetime
      (* (meters 5.0) bh-difficulty-scale)))        ;; Speed
      (pickup-collectable! (-> *target* fact) (pickup-type eco-pill) 5.0 (the-as handle #f))
  (none))

(defun runs-on-cell-pickup ((cell-event symbol))
  (when (-> *pc-settings* skip-cells?)
    (sound-play "cell-prize")
  )
  (+! bh-difficulty (/ 1.0 bh-difficulty-peak))
      ;; Picking up power cells gives 1 health
      (when *target* 
        (set! (-> *target* fact health) (fmin (-> *target* fact health-max) (+ (-> *target* fact health) 1.0)))
      )
      (bh-clear-bullets)
  (none))

(defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
  (let* ((from-vent? (and parent (type-type? (-> parent type) vent))))
    ;; Code here runs as soon as you pickup ANY eco
    (case eco-type
      (((pickup-type eco-yellow))
       ;; Code here runs as soon as you pickup yellow eco
       )
      (((pickup-type eco-red))
       ;; Code here runs as soon as you pickup red eco
       )
      (((pickup-type eco-blue))
       ;; Code here runs as soon as you pickup blue eco
       )
      (((pickup-type eco-pill))
       ;; Code here runs as soon as you pickup small green eco
       )
      (((pickup-type eco-green))
       ;; Code here runs as soon as you pickup big green eco 
       ))
    (when from-vent?
      ;; Code here runs only if the eco was picked up from a vent
      ))
  (none))

(defun runs-on-jak-spawn ()
  (set! *bh-resume-time* (+ (current-time) (seconds 2.0)))
  (set! bh-difficulty-start 0.0)
  (set! bh-difficulty 0.0)
  (bh-clear-bullets)
  (set! bh-difficulty-target
        (fmax 0.0
          (fmin 1.0
            (/ (the float (-> *game-info* fuel))
               bh-difficulty-peak))))

  (set! bh-difficulty-time
        (the float (+ (current-time)
           (seconds bh-difficulty-reset-duration))))

  (none))

(defun runs-on-jak-death ((death-event symbol))
  (case death-event
    (('dying)
      (bh-clear-bullets)
     ;; Code here runs immediately every time jak dies, before any death animation or death cutscene
     )
    (('blackout)
     ;; Code here runs after jak dies (and any death cutscene finishes), during the blackout before he spawns
     ))
  (none))
  